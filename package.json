{
  "name": "pret",
  "main": "lib/index.js",
  "types": "client/index.d.ts",
  "version": "0.6.4",
  "scripts": {
    "build:lib": "tsc -p tsconfig.lib.json",
    "build": "jlpm clean && jlpm build:standalone && jlpm build:jupyter",
    "build:dev": "jlpm clean && jlpm build:standalone:dev && jlpm build:jupyter:dev",
    "build:standalone": "webpack --config webpack/webpack.config.js --mode development",
    "build:standalone:dev": "webpack --config webpack/webpack.config.js --mode development",
    "build:jupyter": "jlpm build:lib && jupyter labextension build --development True .",
    "build:jupyter:dev": "jlpm build:lib && jupyter labextension build --development True .",
    "clean": "rm -rf lib pret/js-extension pret/js-base"
  },
  "peerDependencies": {
    "@jupyterlab/application": "",
    "@jupyterlab/apputils": "",
    "@jupyterlab/docregistry": "",
    "@jupyterlab/logconsole": "",
    "@jupyterlab/mainmenu": "",
    "@jupyterlab/notebook": "",
    "@jupyterlab/outputarea": "",
    "@jupyterlab/rendermime": "",
    "@jupyterlab/services": "",
    "@jupyterlab/settingregistry": "",
    "@lumino/algorithm": "",
    "@lumino/coreutils": "",
    "@lumino/disposable": "",
    "@lumino/properties": "",
    "@lumino/signaling": "",
    "@lumino/widgets": "",
    "react": ">=17.0.2",
    "react-dom": ">=17.0.2"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "apache-arrow": "^18.1.0",
    "css-loader": "^6.7.3",
    "node-fetch": "^3.3.2",
    "react-router": "^6.4",
    "react-router-dom": "^6.4",
    "regenerator-runtime": "^0.13.11",
    "style-loader": "^3.3.2",
    "use-sync-external-store": "^1.2.0"
  },
  "devDependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@jupyterlab/application": "^3.6.8",
    "@jupyterlab/builder": "^3.6.3",
    "@jupyterlab/galata": "5.5.11",
    "@jupyterlab/logconsole": "^3.6.8",
    "@jupyterlab/notebook": "^3.6.8",
    "@playwright/test": "1.62.1",
    "@types/use-sync-external-store": "^0.0.6",
    "esbuild": "^0.25.12",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.1",
    "istanbul-lib-instrument": "^6.0.3",
    "old-galata": "npm:@jupyterlab/galata@^4.5.8",
    "playwright": "1.62.1",
    "prettier": "^2.8.8",
    "process": "^0.11.10",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "source-map-loader": "^5.0.0",
    "string-replace-loader": "^3.1.0",
    "ts-loader": "^9.4.2",
    "typescript": "^5.8.2",
    "v8-to-istanbul": "^9.3.0",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "jsdom": "^20.0.3"
  },
  "jupyterlab": {
    "extension": "lib/jupyter/plugin",
    "schemaDir": "client/jupyter/schema",
    "outputDir": "pret/js-extension",
    "webpackConfig": "./webpack/webpack.jupyter.js",
    "sharedPackages": {
      "pret": {
        "singleton": true
      }
    }
  },
  "prettier": {},
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@playwright/test": "1.62.1",
    "playwright": "1.62.1",
    "playwright-core": "1.62.1"
  }
}
